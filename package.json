{
  "name": "mioku",
  "version": "1.0.0",
  "author": "Jerryplusy",
  "license": "MIT",
  "engines": {
    "node": ">= 22.18.0"
  },
  "description": "Mioku - A plugin-based QQ bot framework",
  "private": false,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "start": "cd example && bun run start",
    "dev": "cd packages/mioku && bun run dev",
    "build": "for pkg in packages/*/; do [ -f \"$pkg/package.json\" ] && [ -d \"$pkg/src\" -o -f \"$pkg/tsdown.config.ts\" ] && (echo \"Building $pkg\" && cd \"$pkg\" && bun run build); done",
    "typecheck": "bunx tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.0.0"
  }
}
